# Copy this file to .env and put your own passwords.
# The host names are the Docker container names (see docker-compose.yml).

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=flight_staging

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DATABASE=flight_analytics

# Optional: a Slack incoming webhook link. Empty = alerts only go to data/alerts.log
SLACK_WEBHOOK_URL=
